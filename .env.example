# ==============================================================================
# SECURE COURSE DRM PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server Port (default: 3000)
PORT=3000

# Node Environment ('development' | 'production')
NODE_ENV=development

# Admin Session JWT / HMAC Signature Secret
# IMPORTANT: In production, generate a long random 64+ char secret string
ADMIN_JWT_SECRET=secure-drm-admin-session-secret-key-2026

# Vercel Runtime Indicator (set automatically by Vercel deployment)
# VERCEL=1
