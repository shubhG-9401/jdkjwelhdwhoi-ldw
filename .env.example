# ==============================================================================
# SECURE COURSE DRM PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server Port (default: 3000)
PORT=3000

# Node Environment ('development' | 'production')
NODE_ENV=development

# Admin Session JWT / HMAC Signature Secret
# Generate a long random 64+ char secret string
ADMIN_JWT_SECRET=secure-drm-admin-session-secret-key-2026

# ==============================================================================
# OPTION 1: UPSTASH REDIS / VERCEL KV (Automatic on Vercel Integration)
# When you connect Upstash on Vercel, these are injected automatically:
# ==============================================================================
# KV_REST_API_URL="https://...upstash.io"
# KV_REST_API_TOKEN="..."
# KV_REST_API_READ_ONLY_TOKEN="..."
# KV_URL="redis://default:...@...upstash.io:6379"
# REDIS_URL="redis://default:...@...upstash.io:6379"

# ==============================================================================
# OPTION 2: MONGODB ATLAS (Free M0 Cluster)
# ==============================================================================
# MONGODB_URI="mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
# MONGODB_DB_NAME="secure_course_drm"

# ==============================================================================
# OPTION 3: GITHUB REPOSITORY AUTO-SYNC (Zero-Cost Database via Git)
# ==============================================================================
# GITHUB_TOKEN="ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# GITHUB_REPO="shubhG-9401/jdkjwelhdwhoi-ldw"

# ==============================================================================
# RENDER 24/7 KEEP-ALIVE (Prevents free container spin-down)
# ==============================================================================
# RENDER_EXTERNAL_URL="https://your-service.onrender.com"
